SPRING_PROFILES_ACTIVE=prod
MYSQL_DATABASE=wonnie
MYSQL_USER=wonnie
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
RABBITMQ_USER=wonnie
RABBITMQ_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

# 수동 실행에서 OpenAI를 쓸 때 키를 넣고 SPRING_PROFILES_ACTIVE=prod,openai 로 변경합니다.
# GitHub Actions 배포는 OPENAI_API_KEY Secret을 전달하므로 아래 값은 비워둬도 됩니다.
OPENAI_API_KEY=

# Google OIDC를 사용할 때만 값을 넣고 프로필에 google-oidc를 추가합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
