{
  "name": "wonnie_response",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "should_respond",
      "primary_moment_id",
      "modifier_moment_ids",
      "novel_combination",
      "tone",
      "message",
      "buttons",
      "calendar_event",
      "used_fact_refs",
      "next_candidates",
      "reason"
    ],
    "properties": {
      "should_respond": {
        "type": "boolean",
        "description": "PROACTIVE에서 물을 가치가 있으면 true. CHAT은 항상 true."
      },
      "primary_moment_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "주 순간 id. 형식 M-R{01~13}-{S|C1~C8|W|P1~P4|G1~G3|GW}. 예: M-R08-W"
      },
      "modifier_moment_ids": {
        "type": "array",
        "description": "곁들인 순간 id (최대 2개) + 말투 수정자 R11 칸.",
        "items": {
          "type": "string"
        }
      },
      "novel_combination": {
        "type": "boolean",
        "description": "02 문서에 없는 조합을 썼으면 true."
      },
      "tone": {
        "type": "string",
        "enum": [
          "CELEBRATE",
          "SUGGEST",
          "CAUTION",
          "FORMAL",
          "STEP_BACK",
          "ANSWER"
        ]
      },
      "message": {
        "type": "string",
        "description": "고객에게 보일 말. 2문장 이내(CAUTION·FORMAL 3문장), 200자 이내. 숫자는 컨텍스트 값만."
      },
      "buttons": {
        "type": "array",
        "description": "0~3개.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "action",
            "target_id"
          ],
          "properties": {
            "label": {
              "type": "string",
              "description": "버튼 문구, 12자 이내."
            },
            "action": {
              "type": "string",
              "enum": [
                "KEEP",
                "CANCEL_GUIDE",
                "PLAN_CHANGE_GUIDE",
                "REMIND_LATER",
                "SKIP",
                "DISMISS",
                "SAVE_TO_DEPOSIT",
                "RECEIVE_KKULMONEY",
                "DECLINE_SAVING",
                "PAUSE_SAVING_PLAN",
                "KEEP_SAVING_PLAN",
                "SHOW_SAVINGS",
                "CONFIRM_RESUBSCRIBED",
                "CHANGE_CARD_GUIDE",
                "UPDATE_CARD_INFO_GUIDE",
                "SHOW_CARD_BENEFIT",
                "CONFIRM_LABEL",
                "HOW_TO_CHECK_GUIDE",
                "CALENDAR_PREVIEW",
                "SHOW_SUBSCRIPTIONS",
                "REFUND_GUIDE",
                "SUPPORT_GUIDE",
                "USE_POINTS_GUIDE",
                "MUTE_THIS_ROW"
              ]
            },
            "target_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "컨텍스트에 있는 id (구독·카드·상품·행·절약 원장 ledger_id·적립 계획 plan_id). 없으면 null."
            }
          }
        }
      },
      "calendar_event": {
        "type": [
          "object",
          "null"
        ],
        "description": "CALENDAR_PREVIEW 버튼이 있을 때만 채운다. 등록은 고객 확인 후 앱이 한다.",
        "additionalProperties": false,
        "required": [
          "event_type",
          "title",
          "date",
          "remind_minutes_before",
          "show_amount"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "SUBSCRIPTION_CHARGE",
              "TRIAL_END",
              "CANCEL_REMINDER",
              "RENEWAL",
              "NEXT_CHARGE",
              "REVISIT_CHECK",
              "CARD_SCHEDULE",
              "SAVING_GOAL",
              "CUSTOM"
            ]
          },
          "title": {
            "type": "string",
            "description": "예: '왓챠 결제일'. 금액은 show_amount가 true일 때만 제목에 넣는다."
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "remind_minutes_before": {
            "type": "integer"
          },
          "show_amount": {
            "type": "boolean",
            "description": "기본 false (공유 캘린더 노출 방지)."
          }
        }
      },
      "used_fact_refs": {
        "type": "array",
        "description": "메시지에 쓴 사실의 출처. 예: signal:sig-r03-watcha-1028, subscription:sub-watcha, card:card-5678, kb:CARD-ROUTINE",
        "items": {
          "type": "string"
        }
      },
      "next_candidates": {
        "type": "array",
        "description": "이번에 고르지 않은 다른 순간 id.",
        "items": {
          "type": "string"
        }
      },
      "reason": {
        "type": "string",
        "description": "내부 로그용 한 문장. 왜 이 순간·조합을 골랐는지."
      }
    }
  }
}